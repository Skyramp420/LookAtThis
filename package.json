{
  "name": "lookatthis",
  "productName": "LookAtThis",
  "version": "1.0.23",
  "description": "Ľahký replay buffer a nahrávanie obrazovky s viacerými zvukovými stopami, odolný voči SteelSeries Sonar.",
  "author": "Alex Troják",
  "repository": "github:Skyramp420/LookAtThis",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "electron-updater": "6.8.9",
    "ffmpeg-static": "5.3.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "sk.shapefx.lookatthis",
    "productName": "LookAtThis",
    "files": [
      "src/**/*",
      "assets/**/*",
      "native/fxaudio.exe",
      "native/fxkeys.exe",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "LookAtThis-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LookAtThis",
      "deleteAppDataOnUninstall": false
    },
    "asarUnpack": [
      "assets/**",
      "native/**",
      "node_modules/ffmpeg-static/**"
    ],
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  }
}
